import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';
---
<Base title="Request a quote" description="Request a quote from AI Virtual Assistant Co: what to include in your enquiry. No payment is taken on this site." path="contact/">
<div class="wrap read page-body"><h1>Request a quote</h1>
<p>This site does not yet have an enquiry form or payment system, and no payment is taken here. A contact method is being set up.</p><div class="notice"><strong>Contact method pending.</strong> The site owner has not yet chosen how enquiries will be received. Please check back soon.</div><h2>What to include when it opens</h2><ul><li>Which service: inbox drafts, meeting notes, research, CRM updates or document cleanup</li><li>A short description of the task and roughly how often you need it</li><li>Any tools involved (email provider, CRM)</li><li>Anything that must stay private or untouched</li></ul><p>You will receive a quote for your request. No prices are published on this site.</p>
</div></Base>
